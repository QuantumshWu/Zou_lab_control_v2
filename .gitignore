__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
/build/
/zou_lab_control.egg-info/
/.Xil/
/tight_setup_hold_pin*

# Vivado build output: regenerable, and large.  geom.tcl is the exception --
# it is pinned by digest in packages/zlc_pulse/tests/test_fpga_assets.py, so it
# stays under version control as the geometry anchor.
packages/zlc_pulse/fpga/build/*
!packages/zlc_pulse/fpga/build/geom.tcl
packages/zlc_pulse/fpga/.Xil/

# A workspace is somebody's experiment, not part of the product.
**/notebooks/workspace/
# Including the one every launcher opens by default.  It lives INSIDE the
# checkout so that a double-clicked launcher finds the same folder whichever
# one it was, and it is untracked so a pull cannot replace a pulse authored
# between shots and a reclone does not carry one machine's experiment to
# another.
/workspace/

# Numba disk cache: regenerable machine code (bin/warm_numba_cache.bat)
/.numba_cache/
